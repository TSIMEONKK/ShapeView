<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="软件 Canvas 验证页"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_software_canvas_layer_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FF666666"
            android:textSize="13sp" />

        <!-- 软件 Window 下仍使用新方案，阴影和虚线均应完整保留。 -->
        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_software_canvas_effect"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="软件 Canvas：阴影 + 虚线应完整显示"
            android:textColor="@android:color/black"
            android:textSize="15sp"
            app:shape_radius="16dp"
            app:shape_shadowColor="#66FF0000"
            app:shape_shadowHardware="true"
            app:shape_shadowInsetSize="18dp"
            app:shape_shadowOffsetY="6dp"
            app:shape_shadowSize="18dp"
            app:shape_solidColor="@android:color/white"
            app:shape_strokeColor="#FF5A8DDF"
            app:shape_strokeDashGap="6dp"
            app:shape_strokeDashSize="12dp"
            app:shape_strokeSize="2dp" />

        <com.hjq.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="软件 Canvas：仅占位 shadow=0 / inset=18"
            android:textColor="@android:color/black"
            android:textSize="15sp"
            app:shape_radius="16dp"
            app:shape_shadowHardware="true"
            app:shape_shadowInsetSize="18dp"
            app:shape_solidColor="@android:color/white"
            app:shape_strokeColor="#FF5A8DDF"
            app:shape_strokeSize="2dp" />

    </LinearLayout>
</ScrollView>
